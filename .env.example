# Copiar a .env y ajustar. Los valores por defecto sirven solo para local.

# Clave que exige triage-service en la cabecera X-API-Key
TRIAGE_API_KEY=triage-local-key
# Clave que exige asistente-service en la cabecera X-API-Key
ASISTENTE_API_KEY=asistente-local-key

# Credenciales de PostgreSQL (solo local)
DB_USER=triage
DB_PASSWORD=triage-local-pass

# Clave del proveedor LLM compatible con OpenAI. Vacía: el asistente arranca en modo degradado
# y responde 503 a las consultas que sí tienen protocolo.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Webhook de alertas médicas. Por defecto apunta al receptor de demo del compose (ver sus logs)
WEBHOOK_ALERTAS_URL=http://webhook-echo:8080/alertas

# Trazas distribuidas hacia Jaeger (UI en http://localhost:16686)
TRACING_ENABLED=true

# SLA en minutos por nivel. Bajarlos permite ver el escalamiento en una demo
TRIAGE_SLA_CRITICO_MINUTOS=5
TRIAGE_SLA_URGENTE_MINUTOS=10
TRIAGE_SLA_URGENTE2_MINUTOS=30
TRIAGE_SLA_NO_URGENTE_MINUTOS=60
TRIAGE_SLA_NO_URGENTE2_MINUTOS=120
# Cada cuánto revisa el monitor de SLA (ms)
TRIAGE_JOBS_SLA_INTERVALO_MS=15000
